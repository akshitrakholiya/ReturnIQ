# ReturnIQ server settings. Copy to .env and adjust:  cp .env.example .env
# Every value below has a default in app/core/config.py; the ones left uncommented
# are what a local setup actually needs.

# ───────────── Database admin (used only by scripts/init_db.py) ─────────────
# Creates the database and the app/tools roles. Empty user = connect as the current OS user
# (Homebrew Postgres); with the Docker image `postgres:16` it is postgres/<POSTGRES_PASSWORD>.
ADMIN_DB_USER=postgres
ADMIN_DB_PASSWORD=postgres

# ───────────── Agents ─────────────
# stub = scripted model, no network. gemini = real Gemini via Google ADK (needs GOOGLE_API_KEY).
LLM_MODE=stub
# Read by the Google SDK from the process environment. Get one at https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# Optional backup keys, comma-separated, tried in order after GOOGLE_API_KEY when a call fails (quota, timeout, 5xx).
# Quota is per Google Cloud project, so each backup key must come from a different project.
GOOGLE_API_KEYS=

# RETURN_MODEL=gemini-3-flash-preview
# MEDIA_MODEL=gemini-3.1-flash-lite
# MODEL_FALLBACKS=gemini-3.1-flash-lite,gemini-3.5-flash-lite
# MAX_RETURN_TOOL_CALLS=3
# LLM_TIMEOUT_SECONDS=60
# LLM_RETRY_ATTEMPTS=4
# MANUAL_REVIEW_CONFIDENCE=0.60

# ───────────── Flow B (product reports) ─────────────
# End of every 90-day report window. Pin it to the demo data's last day (scripts/plant_flow_b.py
# prints the value) so the data never ages out; leave empty to use the current time.
REPORT_AS_OF=2026-10-16
# RCA_MODEL=                        # empty = RETURN_MODEL; set a stronger model if RCA quality needs it
# MAX_RCA_TOOL_CALLS=6
# MAX_QA_TOOL_CALLS=5
# MIN_RETURNS_FOR_ANALYSIS=5        # fewer -> "not enough data yet"
# HEALTHY_RATE_MULTIPLIER=1.2       # rate <= 1.2x category and not rising -> "looks healthy"
# TREND_CHANGE_RATIO=0.15           # rate moved >= 15% vs previous period -> rising / falling
# RCA_MIN_RETURNS=5                 # a root cause needs >= 5 supporting returns
# RCA_MIN_SHARE=0.20                # ...and >= 20% of the period's returns
# REPORT_REBUILD_MIN_REVIEWS=3      # rebuild a stale report after 3+ new reviewed returns
# FEEDBACK_PER_CAUSE=15
# REPORT_RUN_TIMEOUT_MINUTES=10

# ───────────── App database ─────────────
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=returniq
# DB_USER=returniq_app
# DB_PASSWORD=returniq_app
# Read-only role the agent tools connect as
# TOOLS_DB_USER=returniq_tools
# TOOLS_DB_PASSWORD=returniq_tools

# ───────────── Media uploads ─────────────
# Change the signing secret for anything that is not your own machine.
MEDIA_SIGNING_SECRET=dev-secret-change-me
# MEDIA_DIR=media_uploads
# PUBLIC_BASE_URL=http://localhost:8000
# UPLOAD_URL_TTL_SECONDS=900
# MAX_MEDIA_FILES=5
# MAX_PHOTO_BYTES=10485760
# MAX_VIDEO_BYTES=52428800
